NODE_ENV=development

# Shopify (Partner Dashboard -> Trekiva Notify). Never commit real values.
SHOPIFY_API_KEY=dev
SHOPIFY_API_SECRET=dev
SHOPIFY_APP_URL=https://notify.example.com
SCOPES=read_products,read_inventory,read_locations,read_orders

# PostgreSQL. Host is "postgres" inside docker compose, "localhost:5434" for local dev (see docker-compose.dev.yml).
DATABASE_URL=postgresql://notify:change-me@localhost:5434/notify?schema=public

# docker-compose only
POSTGRES_USER=notify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notify

LOG_LEVEL=info
SUBSCRIBE_RATE_LIMIT_PER_MIN=5
# SHOP_CUSTOM_DOMAIN=

# The app runs its own schedules (restock retries every minute, reports, a stock check every 6 hours).
# Set to true only if an external scheduler calls the /api/cron/* endpoints instead.
# DISABLE_SCHEDULER=true

# Calls to /api/cron/* send "Authorization: Bearer <CRON_SECRET>" (openssl rand -hex 24).
CRON_SECRET=ebcc919129ee2ce3d2b4998ee856ac2d53b63b10c44fbf0b

# Resend. EMAIL_FROM must be on a domain verified in Resend, e.g. "Trekiva <notify@trekiva.com>".
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_REPLY_TO=
# RESEND_WEBHOOK_SECRET=

# --- production (docker-compose.yml) ---
SERVER_NAME=notify.example.com
# TLS_CERT_DIR=./deploy/certs
# APP_BIND=127.0.0.1
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
