{%- comment -%}
  Trekiva Notify app embed. Enable it in Online Store > Themes > Customize > App embeds.
  It covers every page that shows products (product, collection, search, home). Presentation settings
  come from the app proxy; nothing secret is rendered here.

  This block targets <head> on purpose: the stylesheet and the "sold out" style below are in place
  before the first paint, so a sold-out variant never flashes its native Add to cart / Buy it now.
{%- endcomment -%}
{%- liquid
  assign hide_early = false
  if request.page_type == 'product' and product and block.settings.hide_purchase_buttons and request.design_mode == false
    assign selected = product.selected_or_first_available_variant
    unless selected.available
      assign hide_early = true
    endunless
  endif
-%}
<link rel="stylesheet" href="{{ 'trekiva-notify.css' | asset_url }}">
<script type="application/json" id="trekiva-notify-config">
  {
    "proxyBase": "/apps/notify",
    "pageType": {{ request.page_type | json }},
    "designMode": {{ request.design_mode | json }},
    "hide": {{ block.settings.hide_purchase_buttons | json }},
    "hideSelectors": {{ block.settings.hide_selectors | json }},
    "cardSelector": {{ block.settings.card_selector | json }}
  }
</script>
{%- if request.page_type == 'product' and product -%}
  <script type="application/json" id="trekiva-notify-product">
    {
      "id": {{ product.id }},
      "handle": {{ product.handle | json }},
      "tags": {{ product.tags | json }},
      "collections": [{% for c in product.collections %}{{ c.id }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "variants": [
        {%- for v in product.variants -%}
          { "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
{%- if hide_early -%}
  {%- comment -%}
    The selected variant is sold out: hide the purchase buttons now, from the first paint. The script
    removes this style as soon as it has taken over. If it never does (blocked, app down), the buttons
    reappear by themselves after 4 seconds, so a customer is never left without them.
  {%- endcomment -%}
  <style id="trekiva-notify-early">
    form[action*="/cart/add"] [type="submit"],
    form[action*="/cart/add"] button[name="add"],
    .shopify-payment-button,
    [data-shopify="payment-button"] {
      visibility: hidden;
      animation: trekiva-notify-reveal 0s linear 4s forwards;
    }
    @keyframes trekiva-notify-reveal { to { visibility: visible; } }
  </style>
{%- endif -%}
<script src="{{ 'trekiva-notify.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Trekiva Notify",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_purchase_buttons",
      "label": "Replace Add to cart and Buy it now when sold out",
      "info": "Hides the purchase buttons for a sold-out variant so only Notify me shows. Turn off to keep your theme's own sold-out behavior.",
      "default": true
    },
    {
      "type": "text",
      "id": "hide_selectors",
      "label": "Extra selectors to hide when sold out",
      "info": "Comma-separated CSS selectors for Add to cart / Buy it now buttons your theme shows on sold-out variants."
    },
    {
      "type": "text",
      "id": "card_selector",
      "label": "Product card selector",
      "info": "Only if the Notify me button is missing on collection or search cards. Example: .my-product-card"
    }
  ]
}
{% endschema %}
